{
  "name": "biofigure-lab",
  "version": "0.0.0",
  "private": true,
  "description": "A free, open-source tool for making scientific figures",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest --run && npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test",
    "storybook": "npm run storybook -w packages/ui",
    "icons": "node scripts/icons.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
