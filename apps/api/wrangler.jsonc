// One Worker serves the app files and the /api routes at one address.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "biofigure-lab-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // No usage reporting to Cloudflare
  "send_metrics": false,

  // The files to serve: build the editor (`npm run build -w apps/editor`) and copy apps/editor/dist to dist/app/,
  // so the editor is at /app. Anything else you put in dist/ is served at /.
  // Only /api/* and figure links (/app/fig/<id>) run the Worker first; every other address gets the files directly.
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app/fig/*"]
  },

  // Local development and tests use simulated resources.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biofigurelab-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "biofigurelab-files-local"
    }
  ]
}
